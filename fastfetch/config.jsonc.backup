
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch3"
     },

  "display": {
    "separator": " ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "│ {#34} user     {#keys}│",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ {#34}󰇅 hostname {#keys}│",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "│ {#34}󰣇 distro   {#keys}│"
    },
    {
      "type": "kernel",
      "key": "│ {#34} kernel   {#keys}│"
    },
    {
      "type": "uptime",
      "key": "│ {#34}󰅐 uptime   {#keys}│"
    },
    {
      "type": "wm",
      "key": "│ {#34} wm       {#keys}│"
    },
    {
      "type": "de",
      "key": "│ {#34}󰇄 desktop  {#keys}│"
    },
    {
      "type": "terminal",
      "key": "│ {#34} terminal {#keys}│"
    },
    {
      "type": "shell",
      "key": "│ {#34} shell    {#keys}│"
    },
    {
      "type": "cpu",
      "key": "│ {#34}󰍛 cpu      {#keys}│",
      "showPeCoreCount": true
    },
    {
      "type": "disk",
      "key": "│ {#34}󰉉 disk     {#keys}│",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│ {#34} memory   {#keys}│"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────┤"
    },
    {
      "type": "colors",
      "key": "│ {#34} colors   {#keys}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────╯"
    }
  ]
}
