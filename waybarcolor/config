{
    "include": [
    "~/.config/waybar/modules.json"
    ],

    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 6,

    "modules-left": [
        "group/workspaces",
        "group/taskbar",
        "custom/nowplaying"
    ],

    "modules-center": [
        "clock"

    ],

    "modules-right": [
        "group/system",
        "group/media",
        "group/actions",
        "custom/random-workspace-colors"
    ],

    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/workspace-1",
            "custom/workspace-2",
            "custom/workspace-3",
            "custom/workspace-4",
            "custom/workspace-5",
            "custom/workspace-6",
            "custom/workspace-7",
            "custom/workspace-8",
            "custom/workspace-9",
            "custom/workspace-10",
            "custom/workspace-watcher"
        ]
    },

    "custom/workspace-1": {
        "exec": "bash ~/.config/waybar/themes/waybarcolor/workspace-status.sh 1",
        "return-type": "json",
        "signal": 8,
        "hide-empty-text": true,
        "on-click": "hyprctl dispatch workspace 1",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
